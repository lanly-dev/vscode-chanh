{
  "name": "chanh",
  "displayName": "Chanh 🍋 - run your free local AI",
  "description": "Run a local AI server powered by Lemonade Server directly in VS Code",
  "publisher": "lanly-dev",
  "version": "0.1.0",
  "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "agent",
    "ai",
    "chanh",
    "chat",
    "free",
    "lemon",
    "lemonade",
    "llm",
    "local",
    "models"
  ],
  "icon": "media/chanh.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "chanh",
        "displayName": "Chanh - Lemonade"
      }
    ],
    "chatParticipants": [
      {
        "id": "CHANH_CHAT",
        "name": "Chanh",
        "description": "Chat with a local AI model powered by Lemonade Server",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Generate a fix for the selected code"
          },
          {
            "name": "explain",
            "description": "Explain the selected code"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "chanh.startServer",
        "title": "Chanh: Start Server",
        "icon": "$(play)"
      },
      {
        "command": "chanh.stopServer",
        "title": "Chanh: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "chanh.downloadBinary",
        "title": "Chanh: Download/Update Binary"
      },
      {
        "command": "chanh.openBinaryDir",
        "title": "Chanh: Open Binary Folder",
        "icon": "$(folder)"
      },
      {
        "command": "chanh.openSettings",
        "title": "Chanh: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "chanh.ncp.downloadModel",
        "title": "Chanh: Download Model",
        "icon": "$(cloud-download)"
      },
      {
        "command": "chanh.ncp.cancelDownload",
        "title": "Chanh: Cancel Download",
        "icon": "$(close)"
      },
      {
        "command": "chanh.toggleModelGrouping",
        "title": "Chanh: Toggle Model Grouping by Capability",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "chanh.toggleDlModelGrouping",
        "title": "Chanh: Toggle Downloadable Models Grouping by Capability",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "chanh.toggleHotModels",
        "title": "Chanh: Toggle Downloadable Hot Models Only",
        "icon": "$(flame)"
      },
      {
        "command": "chanh.ncp.setModelContext",
        "title": "Chanh: Set Context Size",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "chanh.ncp.resetModelContext",
        "title": "Chanh: Reset Context Size to Default",
        "icon": "$(clear-all)"
      },
      {
        "command": "chanh.ncp.showModelInfo",
        "title": "Chanh: Show Model Info",
        "icon": "$(info)"
      },
      {
        "command": "chanh.ncp.loadModel",
        "title": "Chanh: Load Model",
        "icon": "$(run-above)"
      },
      {
        "command": "chanh.ncp.unloadModel",
        "title": "Chanh: Unload Model",
        "icon": "$(run-below)"
      },
      {
        "command": "chanh.ncp.removeModel",
        "title": "Chanh: Remove Model",
        "icon": "$(trash)"
      },
      {
        "command": "chanh.selectChatModel",
        "title": "Chanh: Select Chat Model"
      },
      {
        "command": "chanh.refreshServer",
        "title": "Chanh: Refresh Server Status",
        "icon": "$(refresh)"
      },
      {
        "command": "chanh.selectServer",
        "title": "Chanh: Select Server",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "chanh.setMaxLoadedModels",
        "title": "Chanh: Set Max Loaded Models"
      },
      {
        "command": "chanh.openServerUrl",
        "title": "Chanh: Open Server URL",
        "icon": "$(link-external)"
      },
      {
        "command": "chanh.editServerPort",
        "title": "Chanh: Edit Server Port / URL",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "CHANH_SIDEBAR",
          "title": "Chanh",
          "icon": "media/chanh.svg"
        }
      ]
    },
    "views": {
      "CHANH_SIDEBAR": [
        {
          "id": "CHANH_TREEVIEW",
          "name": "Server",
          "icon": "$(server)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "chanh.refreshServer",
          "when": "view == CHANH_TREEVIEW",
          "group": "navigation"
        },
        {
          "command": "chanh.openSettings",
          "when": "view == CHANH_TREEVIEW",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "chanh.selectServer",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_SERVER_HEADER",
          "group": "inline"
        },
        {
          "command": "chanh.openServerUrl",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "chanh.editServerPort",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.downloadModel",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_DOWNLOADABLE_MODEL",
          "group": "inline"
        },
        {
          "command": "chanh.toggleModelGrouping",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_AVAIL_HEADER",
          "group": "inline"
        },
        {
          "command": "chanh.toggleHotModels",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_DOWNLOADABLE_HEADER",
          "group": "inline"
        },
        {
          "command": "chanh.toggleDlModelGrouping",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_DOWNLOADABLE_HEADER",
          "group": "inline"
        },
        {
          "command": "chanh.startServer",
          "when": "view == CHANH_TREEVIEW && (viewItem == CHANH_SERVER_STOPPED || viewItem == CHANH_SERVER_ERROR) && config.chanh.targetServer == embedded",
          "group": "inline"
        },
        {
          "command": "chanh.stopServer",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_SERVER_RUNNING && config.chanh.targetServer == embedded",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.loadModel",
          "when": "view == CHANH_TREEVIEW && viewItem =~ /CHANH_MODEL_AVAILABLE/",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.unloadModel",
          "when": "view == CHANH_TREEVIEW && (viewItem =~ /CHANH_MODEL_LOADED/ || viewItem == CHANH_LOADED_MODEL)",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.removeModel",
          "when": "view == CHANH_TREEVIEW && (viewItem =~ /CHANH_MODEL_(AVAILABLE|LOADED)/ || viewItem == CHANH_LOADED_MODEL)",
          "group": "2_remove"
        },
        {
          "command": "chanh.ncp.setModelContext",
          "when": "view == CHANH_TREEVIEW && viewItem =~ /CHANH_MODEL_(AVAILABLE|LOADED)/",
          "group": "1_context@1"
        },
        {
          "command": "chanh.ncp.resetModelContext",
          "when": "view == CHANH_TREEVIEW && viewItem =~ /CHANH_MODEL_(AVAILABLE|LOADED)_CTX_SET/",
          "group": "1_context@2"
        },
        {
          "command": "chanh.ncp.showModelInfo",
          "when": "view == CHANH_TREEVIEW && viewItem =~ /CHANH_MODEL_(AVAILABLE|LOADED)/",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.downloadModel",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_PARTIAL_MODEL",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.cancelDownload",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_DOWNLOADING_MODEL",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.removeModel",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_PARTIAL_MODEL",
          "group": "2_remove"
        }
      ]
    },
    "configuration": {
      "title": "Chanh",
      "properties": {
        "chanh.standalonePort": {
          "type": "number",
          "default": 13305,
          "description": "Port for the standalone Lemonade Server"
        },
        "chanh.embeddedPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for the embedded lemond server"
        },
        "chanh.chatModel": {
          "type": "string",
          "description": "Last model to use for chat (leave empty to be prompted)"
        },
        "chanh.customServerUrl": {
          "type": "string",
          "default": "",
          "description": "Custom Lemonade Server URL to use when chanh.targetServer is \"custom\" (e.g., http://localhost:13305)"
        },
        "chanh.targetServer": {
          "type": "string",
          "enum": [
            "standalone",
            "embedded",
            "custom"
          ],
          "default": "standalone",
          "description": "Which Lemonade Server to use for chat. \"standalone\" requires an existing system-installed server; \"embedded\" always runs the bundled binary; \"custom\" connects to chanh.customServerUrl."
        },
        "chanh.maxLoadedModels": {
          "type": "number",
          "description": "Maximum number of loaded models (for each type?), Use -1 for unlimited."
        }
      }
    },
    "commandPalette": [
      {
        "command": "chanh.ncp.downloadModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.cancelDownload",
        "when": "false"
      },
      {
        "command": "chanh.ncp.loadModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.unloadModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.removeModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.setModelContext",
        "when": "false"
      },
      {
        "command": "chanh.ncp.resetModelContext",
        "when": "false"
      },
      {
        "command": "chanh.ncp.showModelInfo",
        "when": "false"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.x",
    "@types/vscode": "^1.134.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanly-dev/vscode-chanh.git"
  },
  "bugs": {
    "url": "https://github.com/lanly-dev/vscode-chanh/issues"
  },
  "license": "MIT"
}
