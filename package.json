{
  "name": "chanh",
  "displayName": "Chanh 🍋 - run your free local AI",
  "description": "Run a local AI server powered by Lemonade Server directly in VS Code",
  "publisher": "lanly-dev",
  "version": "0.1.5",
  "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "agent",
    "ai",
    "chanh",
    "chat",
    "free",
    "lemon",
    "lemonade",
    "llm",
    "local",
    "models",
    "offline",
    "private",
    "server"
  ],
  "icon": "media/chanh.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "CHANH_SIDEBAR",
          "title": "Chanh",
          "icon": "media/chanh.svg"
        }
      ]
    },
    "views": {
      "CHANH_SIDEBAR": [
        {
          "id": "CHANH_TREEVIEW",
          "name": "Server",
          "icon": "$(server)"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "chanh",
        "displayName": "Chanh 🍋",
        "icon": "media/chanh.svg"
      }
    ],
    "chatParticipants": [
      {
        "id": "CHANH_CHAT",
        "name": "Chanh",
        "description": "Chat with a local AI model powered by Lemonade Server",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Generate a fix for the selected code"
          },
          {
            "name": "explain",
            "description": "Explain the selected code"
          },
          {
            "name": "test",
            "description": "Generate unit tests for the selected code"
          },
          {
            "name": "doc",
            "description": "Write documentation for the selected code"
          },
          {
            "name": "refactor",
            "description": "Suggest a refactor of the selected code"
          },
          {
            "name": "reset",
            "description": "Start a fresh conversation (clears the context sent to the model)"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "chanh.downloadBinary",
        "title": "Chanh: Download/Update Binary"
      },
      {
        "command": "chanh.selectChatModel",
        "title": "Chanh: Select Chat Model for @chat"
      },
      {
        "command": "chanh.openWalkthrough",
        "title": "Chanh: Open Get Started Walkthrough"
      },
      {
        "command": "chanh.setMaxLoadedModels",
        "title": "Chanh: Set Max Loaded Models"
      },
            {
        "command": "chanh.ncp.copyModelId",
        "title": "Copy Model ID"
      },
      {
        "command": "chanh.ncp.setModelContext",
        "title": "Set Context Size"
      },
            {
        "command": "chanh.ncp.pinModel",
        "title": "Pin Model"
      },
      {
        "command": "chanh.ncp.unpinModel",
        "title": "Unpin Model"
      },
      {
        "command": "chanh.openLmConfigsFile",
        "title": "Chanh: Open chatLanguageModels.json",
        "icon": "$(file-text)"
      },
      {
        "command": "chanh.openSettings",
        "title": "Chanh: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "chanh.openServerUrl",
        "title": "Chanh: Open Server URL",
        "icon": "$(link-external)"
      },
      {
        "command": "chanh.editServerPort",
        "title": "Chanh: Edit Server Port / URL",
        "icon": "$(edit)"
      },
      {
        "command": "chanh.startServer",
        "title": "Chanh: Start Server",
        "icon": "$(play)"
      },
      {
        "command": "chanh.stopServer",
        "title": "Chanh: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "chanh.switchServer",
        "title": "Chanh: Switch Server",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "chanh.refreshServer",
        "title": "Chanh: Refresh Server Status",
        "icon": "$(refresh)"
      },
      {
        "command": "chanh.ncp.revealBinaryDir",
        "title": "Reveal Binary Folder in File Explorer",
        "icon": "$(folder)"
      },
      {
        "command": "chanh.ncp.downloadModel",
        "title": "Download Model",
        "icon": "$(cloud-download)"
      },
      {
        "command": "chanh.ncp.cancelDownload",
        "title": "Cancel Download",
        "icon": "$(close)"
      },
      {
        "command": "chanh.ncp.loadModel",
        "title": "Load Model",
        "icon": "$(run-above)"
      },
      {
        "command": "chanh.ncp.unloadModel",
        "title": "Unload Model",
        "icon": "$(run-below)"
      },
      {
        "command": "chanh.ncp.removeModel",
        "title": "Remove Model",
        "icon": "$(trash)"
      },
      {
        "command": "chanh.ncp.showModelInfo",
        "title": "Show Model Info",
        "icon": "$(info)"
      },
      {
        "command": "chanh.ncp.resetModelContext",
        "title": "Reset Context Size to Default",
        "icon": "$(clear-all)"
      },
      {
        "command": "chanh.ncp.selectBackend",
        "title": "Select Backend",
        "icon": "$(circuit-board)"
      },
      {
        "command": "chanh.ncp.uninstallBackend",
        "title": "Uninstall Backend",
        "icon": "$(trash)"
      },
      {
        "command": "chanh.ncp.configLmEndpoint",
        "title": "Chanh: Add Entry to VS Code's Chat Custom Endpoints",
        "icon": "$(wrench)"
      },
      {
        "command": "chanh.ncp.toggleModelSectionsHide",
        "title": "Chanh: Hide Installed & Downloadable Sections",
        "icon": "$(eye-closed)"
      },
      {
        "command": "chanh.ncp.toggleModelSectionsShow",
        "title": "Chanh: Show Installed & Downloadable Sections",
        "icon": "$(eye)"
      },
      {
        "command": "chanh.ncp.toggleModelGrouping",
        "title": "Chanh: Toggle Model Grouping by Capability",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "chanh.ncp.toggleDlModelGrouping",
        "title": "Chanh: Toggle Downloadable Models Grouping by Capability",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "chanh.ncp.toggleHotModels",
        "title": "Chanh: Toggle Downloadable Hot Models Only",
        "icon": "$(flame)"
      },
      {
        "command": "chanh.ncp.filterCapGroup",
        "title": "Chanh: Filter by Sub-Capability",
        "icon": "$(filter)"
      },
      {
        "command": "chanh.ncp.clearCapFilter",
        "title": "Chanh: Clear Sub-Capability Filter",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chanh.refreshServer",
          "when": "view == CHANH_TREEVIEW",
          "group": "navigation@1"
        },
        {
          "command": "chanh.ncp.toggleModelSectionsHide",
          "when": "view == CHANH_TREEVIEW && !chanh.modelSectionsHidden",
          "group": "navigation@2"
        },
        {
          "command": "chanh.ncp.toggleModelSectionsShow",
          "when": "view == CHANH_TREEVIEW && chanh.modelSectionsHidden",
          "group": "navigation@2"
        },
        {
          "command": "chanh.openSettings",
          "when": "view == CHANH_TREEVIEW",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "chanh.ncp.revealBinaryDir",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_SERVER_HEADER && config.chanh.serverMode == LEMOND",
          "group": "inline@1"
        },
        {
          "command": "chanh.switchServer",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_SERVER_HEADER",
          "group": "inline@2"
        },
        {
          "command": "chanh.openServerUrl",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "chanh.editServerPort",
          "when": "view == CHANH_TREEVIEW && (viewItem == CHANH_SERVER_URL || viewItem == CHANH_SERVER_ERROR_MSG)",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.downloadModel",
          "when": "view == CHANH_TREEVIEW && (viewItem == CHANH_DOWNLOADABLE_MODEL || viewItem == CHANH_PARTIAL_MODEL)",
          "group": "inline@2"
        },
        {
          "command": "chanh.ncp.toggleModelGrouping",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_INSTALLED_HEADER",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.toggleHotModels",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_DOWNLOADABLE_HEADER",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.toggleDlModelGrouping",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_DOWNLOADABLE_HEADER",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.filterCapGroup",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_CAP_GROUP",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.clearCapFilter",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_CAP_GROUP_FILTERED",
          "group": "inline"
        },
        {
          "command": "chanh.startServer",
          "when": "view == CHANH_TREEVIEW && (viewItem == CHANH_SERVER_STOPPED || viewItem == CHANH_SERVER_ERROR) && config.chanh.serverMode == LEMOND",
          "group": "inline"
        },
        {
          "command": "chanh.stopServer",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_SERVER_RUNNING && config.chanh.serverMode == LEMOND",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.uninstallBackend",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_BACKEND_INSTALLED",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.selectBackend",
          "when": "view == CHANH_TREEVIEW && viewItem =~ /CHANH_MODEL_(INSTALLED|LOADED)/",
          "group": "inline@1"
        },
        {
          "command": "chanh.ncp.configLmEndpoint",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_LOADED_MODEL",
          "group": "inline@2"
        },
        {
          "command": "chanh.ncp.loadModel",
          "when": "view == CHANH_TREEVIEW && viewItem =~ /CHANH_MODEL_INSTALLED/",
          "group": "inline@3"
        },
        {
          "command": "chanh.ncp.unloadModel",
          "when": "view == CHANH_TREEVIEW && (viewItem =~ /CHANH_MODEL_LOADED/ || viewItem == CHANH_LOADED_MODEL)",
          "group": "inline@3"
        },
        {
          "command": "chanh.openLmConfigsFile",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_LOADED_HEADER",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.setModelContext",
          "when": "view == CHANH_TREEVIEW && viewItem =~ /CHANH_MODEL_(INSTALLED|LOADED)/",
          "group": "1_context@1"
        },
        {
          "command": "chanh.ncp.resetModelContext",
          "when": "view == CHANH_TREEVIEW && viewItem =~ /CHANH_MODEL_(INSTALLED|LOADED)_CTX_SET/",
          "group": "1_context@2"
        },
        {
          "command": "chanh.ncp.copyModelId",
          "when": "view == CHANH_TREEVIEW && (viewItem =~ /CHANH_MODEL_(INSTALLED|LOADED)/ || viewItem == CHANH_LOADED_MODEL || viewItem == CHANH_DOWNLOADABLE_MODEL || viewItem == CHANH_PARTIAL_MODEL || viewItem == CHANH_PINNED_MODEL || viewItem =~ /CHANH_MODEL_LOADED_PINNED/ || viewItem =~ /CHANH_LOADED_MODEL_PINNED/)",
          "group": "1_context@3"
        },
        {
          "command": "chanh.ncp.pinModel",
          "when": "view == CHANH_TREEVIEW && (viewItem == CHANH_MODEL_LOADED || viewItem == CHANH_MODEL_LOADED_CTX_SET || viewItem == CHANH_LOADED_MODEL)",
          "group": "1_context@4"
        },
        {
          "command": "chanh.ncp.unpinModel",
          "when": "view == CHANH_TREEVIEW && (viewItem == CHANH_PINNED_MODEL || viewItem =~ /CHANH_MODEL_LOADED_PINNED/ || viewItem =~ /CHANH_LOADED_MODEL_PINNED/)",
          "group": "1_context@4"
        },
        {
          "command": "chanh.ncp.removeModel",
          "when": "view == CHANH_TREEVIEW && (viewItem =~ /CHANH_MODEL_(INSTALLED|LOADED)/ || viewItem == CHANH_LOADED_MODEL || viewItem == CHANH_PARTIAL_MODEL || viewItem == CHANH_PINNED_MODEL || viewItem =~ /CHANH_MODEL_LOADED_PINNED/ || viewItem =~ /CHANH_LOADED_MODEL_PINNED/)",
          "group": "2_remove"
        },
        {
          "command": "chanh.ncp.showModelInfo",
          "when": "view == CHANH_TREEVIEW && (viewItem =~ /CHANH_MODEL_(INSTALLED|LOADED)/ || viewItem == CHANH_DOWNLOADABLE_MODEL)",
          "group": "inline"
        },
        {
          "command": "chanh.ncp.cancelDownload",
          "when": "view == CHANH_TREEVIEW && viewItem == CHANH_DOWNLOADING_MODEL",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Chanh",
      "properties": {
        "chanh.lemonadePort": {
          "type": "number",
          "default": 13305,
          "description": "Port for the Lemonade Server (System)"
        },
        "chanh.lemondPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for the lemond binary server"
        },
        "chanh.chatModel": {
          "type": "string",
          "default": null,
          "description": "Last model to use for chat (leave empty to be prompted)"
        },
        "chanh.customServerUrl": {
          "type": "string",
          "default": null,
          "description": "Custom Lemonade Server URL to use when chanh.serverMode is \"CUSTOM\""
        },
        "chanh.serverMode": {
          "type": "string",
          "enum": [
            "LEMONADE",
            "LEMOND",
            "CUSTOM"
          ],
          "default": "LEMONADE",
          "description": "Which Lemonade Server Mode to use"
        },
        "chanh.maxLoadedModels": {
          "type": "number",
          "default": -1,
          "description": "Maximum number of loaded models (for each type?), Use -1 for unlimited."
        },
        "chanh.showTokenStats": {
          "type": "boolean",
          "default": false,
          "description": "Show per-turn token stats in the chat/agent footer (down from the model's `usage` block)."
        },
        "chanh.systemSampleInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 600,
          "description": "How often (in seconds) the System group samples CPU/GPU/RAM utilization. GPU sampling only runs while the System group is visible and expanded."
        },
        "chanh.completions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show inline (ghost text) code completions from the active Lemonade server as you type. Opt-in: while enabled, code around the cursor from any open file is sent to the active Lemonade server as you type (debounced, with a ~3 second cap per request). In CUSTOM mode, the destination is chanh.customServerUrl and may be remote. Completions only appear while the server is running and a chat model is loaded."
        },
        "chanh.completions.model": {
          "type": "string",
          "default": "",
          "description": "Model to use for inline completions. Leave empty to use the chat model (`chanh.chatModel`), or the currently loaded chat model when no chat model is set. The model is never loaded automatically — it must already be loaded on the server. Small coder models work best."
        }
      }
    },
    "commandPalette": [
      {
        "command": "chanh.ncp.revealBinaryDir",
        "when": "false"
      },
      {
        "command": "chanh.ncp.downloadModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.cancelDownload",
        "when": "false"
      },
      {
        "command": "chanh.ncp.loadModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.unloadModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.removeModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.showModelInfo",
        "when": "false"
      },
      {
        "command": "chanh.ncp.copyModelId",
        "when": "false"
      },
      {
        "command": "chanh.ncp.setModelContext",
        "when": "false"
      },
      {
        "command": "chanh.ncp.resetModelContext",
        "when": "false"
      },
      {
        "command": "chanh.ncp.selectBackend",
        "when": "false"
      },
      {
        "command": "chanh.ncp.uninstallBackend",
        "when": "false"
      },
      {
        "command": "chanh.ncp.pinModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.unpinModel",
        "when": "false"
      },
      {
        "command": "chanh.ncp.configLmEndpoint",
        "when": "false"
      },
      {
        "command": "chanh.ncp.toggleModelSectionsHide",
        "when": "false"
      },
      {
        "command": "chanh.ncp.toggleModelSectionsShow",
        "when": "false"
      },
      {
        "command": "chanh.ncp.toggleModelGrouping",
        "when": "false"
      },
      {
        "command": "chanh.ncp.toggleDlModelGrouping",
        "when": "false"
      },
      {
        "command": "chanh.ncp.toggleHotModels",
        "when": "false"
      },
      {
        "command": "chanh.ncp.filterCapGroup",
        "when": "false"
      },
      {
        "command": "chanh.ncp.clearCapFilter",
        "when": "false"
      }
    ],
    "walkthroughs": [
      {
        "id": "chanh.getStarted",
        "title": "Get Started with Chanh",
        "description": "Run local AI in VS Code, fully offline: start a server, download a model, and chat with it.",
        "steps": [
          {
            "id": "start-server",
            "title": "Start a local server",
            "description": "Get a Lemonade server running, managed by Chanh or your own install.",
            "media": {
              "markdown": "media/walkthrough/01-start-server.md"
            },
            "completionEvents": [
              "onContext:chanh.serverRunning",
              "onCommand:chanh.refreshServer"
            ]
          },
          {
            "id": "download-model",
            "title": "Download a starter model",
            "description": "Grab a chat model from the Downloadable Models section.",
            "media": {
              "markdown": "media/walkthrough/02-download-model.md"
            },
            "completionEvents": [
              "onContext:chanh.modelDownloaded",
              "onCommand:chanh.ncp.downloadModel"
            ]
          },
          {
            "id": "select-chat-model",
            "title": "Pick your chat model",
            "description": "Make the downloaded model the @chanh chat model.",
            "media": {
              "markdown": "media/walkthrough/03-select-chat-model.md"
            },
            "completionEvents": [
              "onContext:chanh.chatModelSelected",
              "onCommand:chanh.selectChatModel"
            ]
          },
          {
            "id": "try-fix",
            "title": "Try @chanh /fix",
            "description": "Fix or explain selected code with your local model.",
            "media": {
              "markdown": "media/walkthrough/04-try-fix.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.chat.open"
            ]
          },
          {
            "id": "agent-mode",
            "title": "Go Agent mode",
            "description": "Use a Chanh model in VS Code's native agent mode.",
            "media": {
              "markdown": "media/walkthrough/05-agent-mode.md"
            },
            "completionEvents": [
              "onContext:chanh.nativeModelUsed"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.x",
    "@types/vscode": "^1.140.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanly-dev/vscode-chanh.git"
  },
  "bugs": {
    "url": "https://github.com/lanly-dev/vscode-chanh/issues"
  },
  "license": "MIT"
}